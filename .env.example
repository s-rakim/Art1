# Settings for the whole of The Bazaar: web app, API, worker, search and
# Caddy. Copy to .env next to compose.yml and fill in. Never commit .env.
#
# Prices are not set here. Shipping, tax, the rider's fee, stall rent and
# placements are set by an admin in the console once the site is up.

# --- The site ----------------------------------------------------------------
# The domain shoppers type. Point its DNS A record at the server first.
# Use localhost for a trial on your own machine.
SITE_DOMAIN=thebazaar.example.com
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=you@example.com
STORE_NAME=The Bazaar
CURRENCY=USD

# --- Supabase: database, sign-in and file storage -----------------------------
# Project Settings > Database > Connection string. Use the session pooler
# (port 5432) and keep ?sslmode=require.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Optional: a read-only role for the search service (DEPLOY.md, step 6).
SEARCH_DATABASE_URL=
# Project Settings > API.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# The anon (public) key. It is built into the web app and that's fine:
# row level security decides what it can read, and it can't write anything.
SUPABASE_ANON_KEY=
# The JWT secret. Leave empty if your project uses the newer asymmetric
# signing keys; tokens are then checked against the project's public keys.
SUPABASE_JWT_SECRET=
# The service_role key. Server side only: the API uses it to store uploads
# and to mirror roles into app_metadata. It never reaches the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Require a second factor (aal2 session) for every admin action. Turn on
# once your own admin account has one set up.
ADMIN_REQUIRE_MFA=false

# --- Maps ----------------------------------------------------------------------
# Where the map opens before any pins load, "lat,lng".
MAP_CENTER=5.6037,-0.1870
# Optional vector map styles (MapLibre style URLs). Empty uses OpenFreeMap.
MAP_STYLE=
MAP_STYLE_DARK=

# --- Deliveries -------------------------------------------------------------------
# Ready orders go to the closest free rider to the shop within this radius.
# A rider who doesn't accept within DISPATCH_ACCEPT_SECONDS is skipped for
# the next closest.
AUTO_DISPATCH=true
DISPATCH_RADIUS_KM=15
DISPATCH_ACCEPT_SECONDS=120

# --- Money -----------------------------------------------------------------------
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM_CENTS=2000
UNPAID_ORDER_TTL_MINUTES=60
# manual: cash on delivery or bank transfer, confirmed by the store or an
# admin. stripe: card checkout (needs both keys).
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uploads ---------------------------------------------------------------------
# Photos are re-encoded to WebP at most IMAGE_MAX_SIDE pixels across.
MAX_IMAGE_BYTES=8000000
IMAGE_MAX_SIDE=2000
MAX_VIDEO_BYTES=50000000
MAX_VIDEO_SECONDS=180
# Outside hosts a store may link product photos from. Empty means photos
# have to be uploaded through the site.
IMAGE_URL_HOSTS=
# Extra image host the web app may show (the Supabase host is allowed already).
IMAGE_HOST=

# --- Limits ----------------------------------------------------------------------
# Requests per minute: per visitor, per account on sensitive actions, and for
# rider GPS updates.
RATE_LIMIT_IP=300
RATE_LIMIT_SENSITIVE=20
RATE_LIMIT_RIDER_LOCATION=30
WEB_CONCURRENCY=2
# Interactive API docs at /api/v1/docs. Leave off unless you need them.
EXPOSE_DOCS=false

# --- First run -----------------------------------------------------------------
# true loads three demo stores and a dozen products on the next migrate.
SEED_DEMO=false

# --- Without Supabase's database (docker compose --profile localdb up) ------------
# DATABASE_URL=postgresql://bazaar:CHANGE-ME@db:5432/bazaar
# LOCAL_DB_PASSWORD=CHANGE-ME

# --- Images ----------------------------------------------------------------------
# Leave as is to build on the server. To pull prebuilt backend images from
# GitHub instead: IMAGE_PREFIX=ghcr.io/s-rakim/bazaar and IMAGE_TAG=latest.
IMAGE_PREFIX=bazaar
IMAGE_TAG=local
