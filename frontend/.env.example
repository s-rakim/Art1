# Where the FastAPI backend lives. Inside docker compose this is usually http://api:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side override, used by server components when the browser URL differs from the internal one
API_URL_INTERNAL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_STORE_NAME=Stallrow
NEXT_PUBLIC_CURRENCY=USD
# Set to "off" to stop falling back to the bundled demo catalogue when the API is down
NEXT_PUBLIC_DEMO_DATA=on

# Map tiles. OpenStreetMap's public tiles are fine for testing; for real traffic use a tile
# host you're allowed to hit at volume (MapTiler, Stadia, or your own tileserver).
NEXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_MAP_CENTER=30.2672,-97.7431
# Optional extra host allowed for product images (Supabase Storage is allowed already)
NEXT_PUBLIC_IMAGE_HOST=
