# Copy to .env and fill in. Every EXPO_PUBLIC_ value is built into the app
# and can be read by anyone who has it, so never put a secret here: no
# service-role key, no Daraja secret, no database password.

# Your site's domain. The API is served under /api/v1 on it (see the root Caddyfile).
EXPO_PUBLIC_API_URL=https://shop.example.com

# Supabase project URL and its public anon key (Project settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Map tiles. OpenStreetMap's own servers are fine for testing; use a tile
# provider or your own server for a fleet of riders.
EXPO_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Optional OSRM-compatible router for road-following route lines,
# e.g. your own OSRM container. Leave empty for straight lines between stops.
EXPO_PUBLIC_ROUTING_URL=

# Optional public key pins for the API host, comma separated, at least two
# (the live key and a backup). See README before turning this on.
EXPO_PUBLIC_API_PINS=
