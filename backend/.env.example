# Copy to .env and fill in. Never commit the real .env.

# --- Where this runs ---------------------------------------------------------
ENVIRONMENT=production
# Public hostname of the API. Caddy gets a certificate for it automatically.
API_DOMAIN=api.yourshop.com
ACME_EMAIL=you@yourshop.com
PUBLIC_API_URL=https://api.yourshop.com
FRONTEND_URL=https://yourshop.com
# Comma separated. Only these origins may call the API from a browser.
CORS_ORIGINS=https://yourshop.com,https://www.yourshop.com
# Comma separated hostnames the API answers to.
TRUSTED_HOSTS=api.yourshop.com

# --- Supabase ----------------------------------------------------------------
# Project Settings > Database > Connection string. Use the session pooler
# (port 5432) or the direct connection. Add ?sslmode=require.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Optional: a read only role for the search service (see README).
# SEARCH_DATABASE_URL=
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings > API > JWT secret. Leave empty if your project uses the
# newer asymmetric signing keys; tokens are then checked against the JWKS.
SUPABASE_JWT_SECRET=
# Project Settings > API > service_role key. Server side only. Used to sign
# image upload URLs and to mirror roles into app_metadata.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=product-images
VIDEO_BUCKET=product-videos
# Upload caps. Photos are re-encoded to WebP at most IMAGE_MAX_SIDE px across.
MAX_IMAGE_BYTES=8000000
IMAGE_MAX_SIDE=2000
MAX_VIDEO_BYTES=50000000
MAX_VIDEO_SECONDS=180
# Outside hosts stores may link product photos from. Empty means photos must
# be uploaded through the API.
IMAGE_URL_HOSTS=
# Require a second factor (aal2 session) for every admin endpoint.
ADMIN_REQUIRE_MFA=false

# --- Without Supabase (docker compose --profile localdb) ----------------------
# DATABASE_URL=postgresql://bazaar:CHANGE-ME@db:5432/bazaar
# LOCAL_DB_PASSWORD=CHANGE-ME
# SUPABASE_JWT_SECRET=a-long-random-string-at-least-32-characters

# --- Money -------------------------------------------------------------------
# Shipping, the rider fee, tax, stall rent and placement prices are set by an
# admin in the console (Admin > Settings and Admin > Plans), not here.
CURRENCY=USD
# Ready orders go to the closest free rider to the shop, within this radius.
# A rider who doesn't accept in time is skipped for the next closest.
AUTO_DISPATCH=true
DISPATCH_RADIUS_KM=15
DISPATCH_ACCEPT_SECONDS=120
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM_CENTS=2000
UNPAID_ORDER_TTL_MINUTES=60

# --- Payments ----------------------------------------------------------------
# manual: cash on delivery / bank transfer, confirmed by the store or an admin.
# stripe: card checkout (needs both keys below). test is refused in production.
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_IP=300
RATE_LIMIT_SENSITIVE=20
RATE_LIMIT_RIDER_LOCATION=30
MAX_BODY_BYTES=1000000
WEB_CONCURRENCY=2
# Interactive docs at /api/v1/docs. Off in production unless you want them.
EXPOSE_DOCS=false

# --- Demo data ---------------------------------------------------------------
# true loads three demo stores and a dozen products on the next migrate.
SEED_DEMO=false

# --- Images ------------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/s-rakim/bazaar
IMAGE_TAG=latest
