# TLS certificates are fetched and renewed automatically for API_DOMAIN.
{
	email {$ACME_EMAIL}
	servers {
		# Real client IPs for rate limiting even behind Cloudflare: list
		# their ranges here if you proxy through it.
		trusted_proxies static private_ranges
	}
}

{$API_DOMAIN} {
	encode zstd gzip

	# Payloads are capped in the API too; this stops abuse at the edge.
	# Only product photo and video uploads may be big.
	@uploads path_regexp ^/api/v1/seller/products/[0-9a-fA-F-]{36}/(images(/[0-9a-fA-F-]{36})?|video)$
	request_body @uploads {
		max_size 60MB
	}
	@everything_else not path_regexp ^/api/v1/seller/products/[0-9a-fA-F-]{36}/(images(/[0-9a-fA-F-]{36})?|video)$
	request_body @everything_else {
		max_size 2MB
	}

	header {
		-Server
		-Via
	}

	# Nothing internal is reachable from outside.
	@internal path /readyz /metrics*
	respond @internal 404

	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
		health_uri /healthz
		health_interval 15s
		# Websockets (live tracking) are proxied as-is.
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}
